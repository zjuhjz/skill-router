{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skillcall.dev/capabilities/image.download/1/output.schema.json",
  "title": "image.download@1 output",
  "type": "object",
  "additionalProperties": true,
  "required": ["meta", "files"],
  "properties": {
    "meta": { "$ref": "#/$defs/meta" },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/file" }
    },
    "extra": { "type": "object" }
  },
  "$defs": {
    "meta": {
      "type": "object",
      "additionalProperties": true,
      "required": ["platform", "id"],
      "properties": {
        "platform": { "type": "string", "minLength": 1 },
        "id": { "type": "string", "minLength": 1 },
        "title": { "type": ["string", "null"] },
        "description": { "type": ["string", "null"] },
        "author": { "type": ["string", "null"] },
        "author_id": { "type": ["string", "null"] },
        "cover": { "type": ["string", "null"] },
        "page_url": { "type": ["string", "null"] }
      }
    },
    "file": {
      "type": "object",
      "additionalProperties": true,
      "required": ["path", "role", "size_bytes"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "role": { "type": "string", "enum": ["image"] },
        "size_bytes": { "type": "integer", "minimum": 0 },
        "sha256": { "type": "string" },
        "index": { "type": "integer", "minimum": 0 },
        "width": { "type": ["integer", "null"] },
        "height": { "type": ["integer", "null"] }
      }
    }
  }
}
