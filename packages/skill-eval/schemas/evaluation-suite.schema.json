{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skillcall.dev/schemas/evaluation-suite.schema.json",
  "title": "skill-eval Suite v1",
  "type": "object",
  "required": ["schema", "id", "version", "capability", "mode", "cases"],
  "properties": {
    "schema": { "const": "skill-eval.suite.v1" },
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]+$" },
    "version": { "type": ["string", "number"] },
    "capability": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:\\.[a-z][a-z0-9_]*)+@[1-9][0-9]*$"
    },
    "mode": { "enum": ["offline", "live"] },
    "repeat": { "type": "integer", "minimum": 1 },
    "environment": {
      "type": "object",
      "properties": {
        "locale": { "type": "string" },
        "region": { "type": "string" },
        "model": { "type": "string" },
        "provider": { "type": "string" }
      },
      "additionalProperties": true
    },
    "limits": {
      "type": "object",
      "properties": {
        "timeout_s": { "type": "number", "exclusiveMinimum": 0 },
        "max_cost_usd": { "type": "number", "minimum": 0 }
      },
      "additionalProperties": true
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "input", "assertions"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "input": { "type": "object" },
          "assertions": {
            "type": "array",
            "items": { "$ref": "#/$defs/assertion" }
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true,
  "$defs": {
    "assertion": {
      "type": "object",
      "required": ["path", "op"],
      "properties": {
        "path": { "type": "string", "pattern": "^(?:/(?:[^~/]|~[01])*)*$" },
        "op": {
          "enum": ["exact", "contains", "regex", "numeric_tolerance", "set_overlap", "exists", "cer_at_most", "wer_at_most"]
        },
        "value": {},
        "tolerance": { "type": "number", "minimum": 0 },
        "minimum": { "type": "number", "minimum": 0, "maximum": 1 },
        "maximum": { "type": "number", "minimum": 0 },
        "lowercase": { "type": "boolean" }
      },
      "allOf": [
        {
          "if": { "properties": { "op": { "enum": ["exact", "contains", "regex", "numeric_tolerance", "set_overlap", "cer_at_most", "wer_at_most"] } } },
          "then": { "required": ["value"] }
        },
        {
          "if": { "properties": { "op": { "const": "numeric_tolerance" } } },
          "then": { "required": ["tolerance"] }
        },
        {
          "if": { "properties": { "op": { "enum": ["cer_at_most", "wer_at_most"] } } },
          "then": { "required": ["maximum"] }
        }
      ],
      "additionalProperties": true
    }
  }
}
