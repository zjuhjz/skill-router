{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skillcall.dev/schemas/fixture-manifest.schema.json",
  "title": "skill-eval Fixture Manifest v1",
  "type": "object",
  "required": ["schema", "id", "version", "samples"],
  "properties": {
    "schema": { "const": "skill-eval.fixtures.v1" },
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]+$" },
    "version": { "type": ["string", "number"] },
    "samples": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/sample" }
    }
  },
  "additionalProperties": true,
  "$defs": {
    "sample": {
      "type": "object",
      "required": ["id", "path", "sha256", "size_bytes", "media_type", "language", "reference", "license", "tags"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$" },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "size_bytes": { "type": "integer", "minimum": 1 },
        "media_type": { "type": "string", "pattern": "^[a-z]+/[a-z0-9.+-]+$" },
        "duration_ms": { "type": "integer", "minimum": 1 },
        "sample_rate_hz": { "type": "integer", "minimum": 1 },
        "channels": { "type": "integer", "minimum": 1 },
        "bit_depth": { "type": "integer", "minimum": 1 },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 },
        "language": { "type": "string", "minLength": 2 },
        "reference": {
          "type": "object",
          "required": ["text"],
          "properties": { "text": { "type": "string", "minLength": 1 } },
          "additionalProperties": true
        },
        "tags": {
          "type": "array",
          "items": {
            "enum": ["mandarin", "english", "code-switching", "noise", "multi-speaker", "numbers", "dates", "proper-nouns", "simplified", "traditional", "printed-text", "clean", "low-contrast", "rotated"]
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "license": {
          "type": "object",
          "required": ["spdx", "source_url", "attribution", "redistribution_allowed"],
          "properties": {
            "spdx": { "type": "string", "minLength": 1 },
            "source_url": { "type": "string", "format": "uri" },
            "attribution": { "type": "string" },
            "redistribution_allowed": { "const": true },
            "proof_url": { "type": "string", "format": "uri" }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    }
  }
}
