{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skillcall.dev/schemas/implementation.schema.json",
  "title": "skillcall Implementation Manifest v0.1",
  "type": "object",
  "required": ["skillcall", "id", "version", "name", "author", "license", "provides"],
  "properties": {
    "skillcall": { "const": "0.1" },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._-]*[A-Za-z0-9])?$"
    },
    "version": {
      "oneOf": [
        { "type": "string", "pattern": "^[0-9]+(?:\\.[0-9]+){0,2}(?:[-+][0-9A-Za-z.-]+)?$" },
        { "type": "number", "minimum": 0 }
      ]
    },
    "name": { "type": "string", "minLength": 1 },
    "author": {
      "oneOf": [
        { "type": "string", "minLength": 1 },
        {
          "type": "object",
          "required": ["name"],
          "properties": {
            "name": { "type": "string", "minLength": 1 },
            "url": { "type": "string", "format": "uri" }
          },
          "additionalProperties": true
        }
      ]
    },
    "license": { "type": "string", "minLength": 1 },
    "homepage": { "type": "string", "format": "uri" },
    "deprecated": { "type": "boolean" },
    "superseded_by": { "type": "string", "minLength": 1 },
    "warmup": { "$ref": "#/$defs/warmup" },
    "provides": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/provision" }
    }
  },
  "additionalProperties": true,
  "$defs": {
    "stringList": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "requires": {
      "type": "object",
      "properties": {
        "env": { "$ref": "#/$defs/stringList" },
        "optional_env": { "$ref": "#/$defs/stringList" },
        "binaries": { "$ref": "#/$defs/stringList" },
        "python": { "$ref": "#/$defs/stringList" },
        "network": { "type": "boolean" }
      },
      "additionalProperties": true
    },
    "entrypoint": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": { "enum": ["command", "mcp", "http"] },
        "command": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1
        },
        "url": { "type": "string", "format": "uri" },
        "tool": { "type": "string", "minLength": 1 }
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "command" } }, "required": ["type"] },
          "then": { "required": ["command"] }
        },
        {
          "if": { "properties": { "type": { "const": "mcp" } }, "required": ["type"] },
          "then": { "required": ["url", "tool"] }
        },
        {
          "if": { "properties": { "type": { "const": "http" } }, "required": ["type"] },
          "then": { "required": ["url"] }
        }
      ],
      "additionalProperties": true
    },
    "healthCheck": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "use_platform_canaries": { "type": "boolean" },
        "samples": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["input"],
            "properties": { "input": { "type": "object" } },
            "additionalProperties": true
          }
        },
        "expect": { "$ref": "#/$defs/stringList" },
        "interval_h": { "type": "number", "exclusiveMinimum": 0 }
      },
      "additionalProperties": true
    },
    "warmup": {
      "type": "object",
      "properties": { "timeout_s": { "type": "number", "exclusiveMinimum": 0 } },
      "additionalProperties": true
    },
    "provision": {
      "type": "object",
      "required": ["capability", "platforms", "entrypoint"],
      "properties": {
        "capability": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:\\.[a-z][a-z0-9_]*)+@[1-9][0-9]*$"
        },
        "platforms": {
          "type": "array",
          "items": {
            "anyOf": [
              { "const": "*" },
              { "type": "string", "pattern": "^[a-z][a-z0-9_-]*$" }
            ]
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "url_patterns": { "$ref": "#/$defs/stringList" },
        "entrypoint": { "$ref": "#/$defs/entrypoint" },
        "timeout_s": { "type": "number", "exclusiveMinimum": 0 },
        "requires": { "$ref": "#/$defs/requires" },
        "cost": { "enum": ["free", "paid", "metered"] },
        "side_effects": { "$ref": "#/$defs/stringList" },
        "health_check": { "$ref": "#/$defs/healthCheck" },
        "deprecated": { "type": "boolean" },
        "superseded_by": { "type": "string", "minLength": 1 },
        "priority": { "type": "integer" },
        "metadata": { "enum": ["rich", "basic"] }
      },
      "additionalProperties": true
    }
  }
}
