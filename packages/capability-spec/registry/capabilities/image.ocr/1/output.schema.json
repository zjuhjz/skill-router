{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skillcall.dev/capabilities/image.ocr/1/output.schema.json",
  "title": "image.ocr@1 output",
  "type": "object",
  "additionalProperties": true,
  "required": ["language", "text", "blocks"],
  "properties": {
    "language": { "type": "string", "minLength": 1 },
    "text": { "type": "string" },
    "blocks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["text"],
        "properties": {
          "text": { "type": "string" },
          "bbox": {
            "type": "array",
            "description": "归一化 [x, y, width, height]，左上角为原点",
            "prefixItems": [
              { "type": "number", "minimum": 0, "maximum": 1 },
              { "type": "number", "minimum": 0, "maximum": 1 },
              { "type": "number", "minimum": 0, "maximum": 1 },
              { "type": "number", "minimum": 0, "maximum": 1 }
            ],
            "items": false,
            "minItems": 4,
            "maxItems": 4
          },
          "confidence": { "type": ["number", "null"], "minimum": 0, "maximum": 1 }
        }
      }
    },
    "meta": { "type": "object", "additionalProperties": true }
  }
}
