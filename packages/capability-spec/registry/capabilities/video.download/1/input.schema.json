{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skillcall.dev/capabilities/video.download/1/input.schema.json",
  "title": "video.download@1 input",
  "type": "object",
  "additionalProperties": true,
  "required": ["url"],
  "properties": {
    "url": { "type": "string", "minLength": 1 },
    "platform": { "type": "string", "minLength": 1 },
    "quality": { "type": "string", "enum": ["best", "1080p", "720p", "smallest"] },
    "prefer_no_watermark": { "type": "boolean", "default": true },
    "require_no_watermark": { "type": "boolean", "default": false },
    "min_height": { "type": "integer", "minimum": 1 }
  }
}
